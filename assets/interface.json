{
    "interface_version": 2,
    "name": "MaaStellaSora-Personal",
    "description": "星塔旅人爬塔助手（个人版）：专注自动爬塔，支持潜能优先级预设、商店音符策略、对话选择存档，由 MaaFramework 强力驱动",
    "contact": "",
    "license": "MIT",
    "welcome": "欢迎使用星塔爬塔助手（个人版）",
    "github": "https://github.com/beichen24a1/MaaStellaSora-Personal",
    "version": "1.2.2-personal.1",
    "custom_title": "星塔爬塔助手",
    "agent": {
        "child_exec": "python",
        "child_args": [
            "-u",
            "./../agent/main.py"
        ],
        "timeout": -1
    },
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "xtlr|星塔旅人|ステラソラ|StellaSora",
                "screencap": "FramePool",
                "mouse": "SendMessageWithCursorPos",
                "keyboard": "SendMessageWithCursorPos"
            },
            "permission_required": true
        },
        {
            "name": "安卓端",
            "type": "Adb"
        },
        {
            "name": "PlayCover",
            "type": "PlayCover"
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "{PROJECT_DIR}/resource/base"
            ]
        },
        {
            "name": "台服",
            "path": [
                "{PROJECT_DIR}/resource/base",
                "{PROJECT_DIR}/resource/tw"
            ]
        },
        {
            "name": "国际服",
            "path": [
                "{PROJECT_DIR}/resource/base",
                "{PROJECT_DIR}/resource/en"
            ]
        },
        {
            "name": "日服",
            "path": [
                "{PROJECT_DIR}/resource/base",
                "{PROJECT_DIR}/resource/jp"
            ]
        }
    ],
    "import": [
        "resource/tasks/climb_tower.json",
        "resource/tasks/climb_tower_presets.json"
    ]
}
