    "option": {
        "新版爬塔_开始位置": {
            "type": "select",
            "label": "开始位置",
            "description": "设置在哪个界面开始任务",
            "default_case": "主页",
            "cases": [
                {
                    "name": "开始位置_主页",
                    "label": "主页",
                    "description": "从主页开始，不需要调整编队时选择"
                },
                {
                    "name": "开始位置_进入星塔后",
                    "label": "进入星塔后",
                    "description": "进入星塔后开始，需要调整编队时或爬塔中断时选择",
                    "pipeline_override": {
                        "星塔_跳过进入星塔流程_agent": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "新版爬塔_爬塔次数": {
            "type": "input",
            "inputs": [
                {
                    "name": "爬塔次数",
                    "pipeline_type": "int",
                    "default": "1",
                    "verify": "^[1-9]\\d*$",
                    "pattern_msg": "请输入爬塔次数"
                }
            ],
            "pipeline_override": {
                "星塔_循环用节点_agent": {
                    "attach": {
                        "loop_count": "{爬塔次数}"
                    }
                }
            }
        },
        "新版爬塔_属性塔": {
            "type": "select",
            "label": "属性塔",
            "default_case": "属性_光土",
            "cases": [
                {
                    "name": "属性_光土",
                    "label": "光土",
                    "pipeline_override": {
                        "星塔_属性塔选择_agent": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "ClimbTower_agent/爬塔_光土__387_137_124_45__337_87_224_145.png"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "属性_水风",
                    "label": "水风",
                    "pipeline_override": {
                        "星塔_属性塔选择_agent": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "ClimbTower_agent/爬塔_水风__384_271_129_39__334_221_229_139.png"
                                    ]
